<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="3dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/card_bg" android:padding="12dp">
        <TextView android:id="@+id/avatar"
            android:layout_width="42dp" android:layout_height="42dp"
            android:gravity="center" android:textColor="#FFFFFF"
            android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/label"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginLeft="14dp"
            android:textColor="#FFFFFF" android:textSize="18sp"
            android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
