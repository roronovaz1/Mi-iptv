<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView android:id="@+id/player"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false" app:resize_mode="fit" />

    <ProgressBar android:id="@+id/spinner"
        android:layout_width="56dp" android:layout_height="56dp"
        android:layout_gravity="center" android:visibility="gone" />

    <TextView android:id="@+id/now"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|start" android:layout_margin="32dp"
        android:background="@drawable/chip_bg" android:paddingLeft="24dp"
        android:paddingRight="24dp" android:paddingTop="12dp" android:paddingBottom="12dp"
        android:textColor="#FFFFFF" android:textSize="20sp" android:visibility="gone" />

    <LinearLayout android:id="@+id/panel"
        android:layout_width="440dp" android:layout_height="match_parent"
        android:orientation="vertical" android:background="@drawable/panel_bg"
        android:paddingLeft="24dp" android:paddingRight="24dp"
        android:paddingTop="28dp" android:paddingBottom="16dp">

        <TextView android:id="@+id/title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Middya IPTV" android:textColor="#FFFFFF"
            android:textSize="30sp" android:textStyle="bold" />

        <TextView android:id="@+id/sub"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#8A93A6" android:textSize="15sp"
            android:paddingTop="4dp" android:paddingBottom="16dp" />

        <EditText android:id="@+id/search"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/search_bg" android:hint="Search channels"
            android:textColorHint="#6B7385" android:textColor="#FFFFFF"
            android:textSize="18sp" android:singleLine="true"
            android:paddingLeft="20dp" android:paddingRight="20dp"
            android:imeOptions="actionSearch" android:inputType="text"
            android:nextFocusDown="@+id/list" android:visibility="gone" />

        <ListView android:id="@+id/list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:divider="@null" android:dividerHeight="0dp"
            android:listSelector="@drawable/list_selector"
            android:nextFocusUp="@+id/search" />
    </LinearLayout>
</FrameLayout>
