<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:keepScreenOn="true">
    <androidx.media3.ui.PlayerView android:id="@+id/player"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false" app:resize_mode="fit" />
    <LinearLayout android:id="@+id/panel"
        android:layout_width="380dp" android:layout_height="match_parent"
        android:orientation="vertical" android:background="#E6111418" android:padding="16dp">
        <TextView android:id="@+id/title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"
            android:paddingBottom="12dp" />
        <ListView android:id="@+id/list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@null" android:listSelector="#664F8CFF" />
    </LinearLayout>
</FrameLayout>
